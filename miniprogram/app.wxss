/* 忆单词 · 小程序端全局样式（仿微信原生视觉） */
page {
  background: #ededed;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  color: #191919;
  line-height: 1.55;
}
view, text, button, input, textarea { box-sizing: border-box; }
.muted { color: #888888; }
.small { font-size: 24rpx; }
.bold { font-weight: 600; }
.green { color: #07c160; }
.red { color: #fa5151; }
.blue { color: #10aeff; }
.rowx { display: flex; align-items: center; }
.spread { display: flex; align-items: center; justify-content: space-between; }
.wrap { padding-bottom: 40rpx; }

/* 卡片与分组列表 */
.card { background: #ffffff; border-radius: 24rpx; margin: 20rpx 24rpx; padding: 28rpx; }
.card-title { font-size: 30rpx; font-weight: 500; margin-bottom: 10rpx; }
.group { background: #ffffff; margin: 20rpx 0; }
.group-title { padding: 24rpx 32rpx 8rpx; font-size: 26rpx; color: #888888; }
.cell { display: flex; align-items: center; padding: 26rpx 32rpx; position: relative; }
.cell + .cell::after {
  content: ''; position: absolute; left: 32rpx; right: 0; top: 0;
  height: 1rpx; background: rgba(0, 0, 0, .07);
}
.cell .ico {
  width: 52rpx; height: 52rpx; border-radius: 14rpx; margin-right: 20rpx;
  color: #fff; font-size: 26rpx; display: flex; align-items: center; justify-content: center; flex: none;
}
.cell .bd { flex: 1; min-width: 0; }
.cell .bd .t { font-size: 30rpx; }
.cell .bd .d { font-size: 24rpx; color: #888888; margin-top: 4rpx; }
.cell .ft { font-size: 26rpx; color: #888888; display: flex; align-items: center; }
.arrow::after {
  content: ''; width: 14rpx; height: 14rpx; margin-left: 8rpx;
  border-top: 3rpx solid #c8c8c8; border-right: 3rpx solid #c8c8c8; transform: rotate(45deg);
}

/* 按钮 */
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; border-radius: 12rpx; background: #07c160; color: #fff; font-size: 32rpx;
  margin: 20rpx 24rpx; padding: 0; line-height: 88rpx;
}
.btn::after { border: none; }
.btn.ghost { background: #fff; color: #191919; border: 1rpx solid rgba(0, 0, 0, .12); }
.btn.soft { background: #e7f7ee; color: #06ad56; }
.btn.warn { background: #fdecec; color: #fa5151; }
.btn.mini { height: 60rpx; line-height: 60rpx; font-size: 26rpx; margin: 0; padding: 0 22rpx; border-radius: 8rpx; display: inline-flex; }
.btn-row { display: flex; margin: 20rpx 24rpx; }
.btn-row .btn { flex: 1; margin: 0 8rpx; }

/* 顶部横幅 */
.banner {
  margin: 20rpx 24rpx; padding: 30rpx;
  background: linear-gradient(135deg, #07c160, #10aeff);
  color: #fff; border-radius: 24rpx;
}
.banner .b1 { font-size: 24rpx; opacity: .9; }
.banner .b2 { font-size: 42rpx; font-weight: 600; margin: 6rpx 0 10rpx; }
.banner .b3 { font-size: 24rpx; opacity: .9; }
.bar { height: 8rpx; border-radius: 4rpx; background: rgba(255, 255, 255, .35); overflow: hidden; margin-top: 18rpx; }
.bar i { display: block; height: 100%; background: #fff; }
.track { height: 8rpx; border-radius: 4rpx; background: #e3e3e3; overflow: hidden; }
.track i { display: block; height: 100%; background: #07c160; }

/* 宫格入口 */
.grid4 { display: flex; margin: 20rpx 16rpx; }
.g4 {
  flex: 1; background: #fff; border-radius: 20rpx; margin: 0 8rpx;
  padding: 22rpx 6rpx; display: flex; flex-direction: column; align-items: center;
}
.gi {
  width: 60rpx; height: 60rpx; border-radius: 16rpx; color: #fff; font-size: 30rpx;
  display: flex; align-items: center; justify-content: center; margin-bottom: 10rpx;
}
.gt { font-size: 26rpx; }
.gd { font-size: 20rpx; color: #b2b2b2; text-align: center; margin-top: 2rpx; }

/* KPI */
.kpis { display: flex; background: rgba(0, 0, 0, .06); border-radius: 20rpx; margin: 20rpx 24rpx; overflow: hidden; }
.kpi { flex: 1; background: #fff; padding: 26rpx 6rpx; text-align: center; }
.kpi .v { font-size: 38rpx; font-weight: 600; }
.kpi .l { font-size: 22rpx; color: #888; margin-top: 4rpx; }

/* 公告 */
.notice {
  margin: 20rpx 24rpx; padding: 20rpx 24rpx; border-radius: 16rpx;
  background: #fff8e6; color: #7a5b12; font-size: 26rpx; line-height: 1.6;
}

/* 分段控件 / 标签 */
.seg { display: flex; background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 6rpx; }
.seg .s { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: #888; border-radius: 12rpx; }
.seg .s.on { background: #ededed; color: #191919; font-weight: 500; }
.chips { display: flex; flex-wrap: wrap; padding: 8rpx 0 0; }
.chip {
  background: #fff; border: 1rpx solid rgba(0, 0, 0, .08); border-radius: 28rpx;
  padding: 10rpx 24rpx; font-size: 26rpx; color: #555; margin: 0 12rpx 12rpx 0;
}
.chip.on { background: #e7f7ee; border-color: #07c160; color: #06ad56; font-weight: 500; }

/* 空态 */
.empty { padding: 90rpx 40rpx; text-align: center; color: #b2b2b2; font-size: 28rpx; }
.empty .box { width: 120rpx; height: 90rpx; margin: 0 auto 24rpx; border: 4rpx dashed #d5d5d5; border-radius: 16rpx; }

/* 翻转卡片 */
.flip { position: relative; margin: 24rpx; }
.face {
  background: #fff; border-radius: 28rpx; padding: 40rpx 34rpx; min-height: 420rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .05);
}
.word-big { font-size: 62rpx; font-weight: 600; letter-spacing: 1rpx; }
.pho { color: #888; font-size: 28rpx; margin-top: 10rpx; display: flex; align-items: center; }
.spk {
  width: 52rpx; height: 52rpx; border-radius: 50%; background: #e7f7ee; color: #06ad56;
  font-size: 24rpx; display: inline-flex; align-items: center; justify-content: center; margin-left: 14rpx;
}
.tag {
  display: inline-block; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx;
  background: #eef3f8; color: #4a6b8a; margin-right: 12rpx;
}
.meaning { font-size: 34rpx; margin: 26rpx 0 18rpx; line-height: 1.6; }
.example { background: #f7f8fa; border-radius: 16rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: #444; line-height: 1.7; }
.example .hl { color: #06ad56; font-weight: 600; }
.hint-c { text-align: center; color: #b2b2b2; font-size: 26rpx; margin-top: 40rpx; }
.srs-meta { display: flex; justify-content: space-between; color: #888; font-size: 24rpx; margin-top: 26rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(0, 0, 0, .07); }

/* 自评按钮 */
.grades { display: flex; margin: 24rpx 16rpx; }
.grades .g {
  flex: 1; background: #fff; border-radius: 18rpx; margin: 0 8rpx; padding: 18rpx 4rpx;
  text-align: center; border: 1rpx solid rgba(0, 0, 0, .06);
}
.grades .g .t { font-size: 28rpx; font-weight: 500; }
.grades .g .s { font-size: 20rpx; color: #b2b2b2; margin-top: 4rpx; }
.g0 .t { color: #fa5151; }
.g1 .t { color: #e6960a; }
.g2 .t { color: #10aeff; }
.g3 .t { color: #07c160; }

/* 选项 */
.opt {
  display: flex; align-items: flex-start; background: #fff; border-radius: 18rpx;
  margin: 16rpx 24rpx; padding: 24rpx; border: 3rpx solid transparent;
}
.opt .i {
  width: 44rpx; height: 44rpx; border-radius: 50%; border: 3rpx solid #d0d0d0; color: #888;
  font-size: 24rpx; display: flex; align-items: center; justify-content: center; flex: none; margin-right: 18rpx;
}
.opt .o { font-size: 30rpx; line-height: 1.5; flex: 1; }
.opt.right { border-color: #07c160; background: #f0fbf5; }
.opt.right .i { background: #07c160; border-color: #07c160; color: #fff; }
.opt.wrong { border-color: #fa5151; background: #fdf2f2; }
.opt.wrong .i { background: #fa5151; border-color: #fa5151; color: #fff; }
.opt.dim { opacity: .55; }
.explain { margin: 8rpx 24rpx 16rpx; background: #fff; border-radius: 18rpx; padding: 24rpx; font-size: 28rpx; line-height: 1.7; }

/* 单词行 */
.wline { display: flex; align-items: center; padding: 24rpx 32rpx; background: #fff; position: relative; }
.wline + .wline::after { content: ''; position: absolute; left: 32rpx; right: 32rpx; top: 0; height: 1rpx; background: rgba(0, 0, 0, .07); }
.wline .w { font-size: 32rpx; font-weight: 500; width: 200rpx; flex: none; }
.wline .m { flex: 1; font-size: 26rpx; color: #888; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wline .s { font-size: 22rpx; color: #06ad56; background: #e7f7ee; border-radius: 8rpx; padding: 4rpx 12rpx; flex: none; }
.wline .s.due { color: #fa5151; background: #fdecec; }

/* 搜索栏 */
.searchbar { display: flex; align-items: center; background: #fff; padding: 20rpx 24rpx; }
.searchbar input { flex: 1; background: #f2f2f2; border-radius: 12rpx; padding: 16rpx 24rpx; font-size: 28rpx; }

/* 图表（纯 view） */
.bars { display: flex; align-items: flex-end; height: 190rpx; }
.bcol { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.bcol .bv { font-size: 20rpx; color: #888; }
.bcol .bb { width: 22rpx; background: linear-gradient(180deg, #07c160, #52d496); border-radius: 8rpx 8rpx 0 0; }
.bcol .bl { font-size: 20rpx; color: #b2b2b2; }
.hbars .hrow { display: flex; align-items: center; margin-bottom: 14rpx; }
.hbars .hrow .hl2 { width: 150rpx; font-size: 24rpx; color: #888; flex: none; }
.hbars .hrow .ht { flex: 1; height: 16rpx; background: #f0f1f3; border-radius: 8rpx; overflow: hidden; }
.hbars .hrow .ht i { display: block; height: 100%; background: #07c160; }
.hbars .hrow .hn { width: 60rpx; text-align: right; font-size: 24rpx; }
.dist { display: flex; height: 24rpx; border-radius: 12rpx; overflow: hidden; background: #eee; margin: 16rpx 0 12rpx; }
.dist i { display: block; height: 100%; }
.legend { display: flex; flex-wrap: wrap; }
.legend .lg { display: flex; align-items: center; font-size: 24rpx; color: #888; margin-right: 24rpx; }
.legend .lg em { width: 16rpx; height: 16rpx; border-radius: 4rpx; margin-right: 8rpx; }
.heat { display: flex; flex-wrap: wrap; }
.heat .hc { width: 52rpx; height: 52rpx; border-radius: 8rpx; background: #eef0f2; margin: 0 8rpx 8rpx 0; }
.heat .hc.l1 { background: #b8ecce; }
.heat .hc.l2 { background: #6fdca0; }
.heat .hc.l3 { background: #26c96f; }
.heat .hc.l4 { background: #07943f; }
.tbl { font-size: 26rpx; }
.tbl .tr { display: flex; padding: 14rpx 0; border-bottom: 1rpx solid rgba(0, 0, 0, .06); }
.tbl .tr th, .tbl .tr .th { flex: 1; color: #888; font-size: 24rpx; }
.tbl .tr td { flex: 1; }

/* 我的 */
.mehead { display: flex; align-items: center; padding: 40rpx 32rpx; background: #fff; }
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%; color: #fff; font-size: 40rpx;
  display: flex; align-items: center; justify-content: center; margin-right: 24rpx; flex: none;
}
.mehead .n { font-size: 34rpx; font-weight: 500; }
.mehead .s { font-size: 24rpx; color: #888; margin-top: 6rpx; }

/* 登录 */
.login { padding: 80rpx 52rpx 60rpx; background: #fff; min-height: 100vh; }
.logo {
  width: 120rpx; height: 120rpx; border-radius: 28rpx; background: #07c160; color: #fff;
  font-size: 52rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 30rpx;
}
.login h2 { font-size: 44rpx; margin: 0; font-weight: 600; }
.login .sub { color: #888; font-size: 26rpx; margin: 12rpx 0 50rpx; }
.ltabs { display: flex; margin-bottom: 30rpx; }
.ltabs .lt { font-size: 30rpx; color: #888; padding: 12rpx 0; margin-right: 48rpx; position: relative; }
.ltabs .lt.on { color: #191919; font-weight: 500; }
.ltabs .lt.on::after {
  content: ''; position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
  width: 44rpx; height: 6rpx; border-radius: 3rpx; background: #07c160;
}
.linput { border-bottom: 1rpx solid #e6e6e6; padding: 24rpx 4rpx; font-size: 32rpx; margin-bottom: 24rpx; width: 100%; }
.login .foot { margin-top: 60rpx; text-align: center; color: #b2b2b2; font-size: 22rpx; line-height: 1.9; }

/* 表单 */
.field { padding: 20rpx 32rpx; background: #fff; }
.field + .field { border-top: 1rpx solid rgba(0, 0, 0, .07); }
.field .lab { font-size: 24rpx; color: #888; margin-bottom: 10rpx; }
.field input, .field textarea { background: #f7f7f7; border-radius: 12rpx; padding: 18rpx 22rpx; font-size: 30rpx; width: 100%; }
.field textarea { height: 160rpx; }
.f-in { background: #f7f7f7; border-radius: 12rpx; padding: 18rpx 22rpx; font-size: 28rpx; width: 100%; }

/* 结果页 */
.result { text-align: center; padding: 60rpx 40rpx 20rpx; }
.ring-wrap {
  position: relative; width: 260rpx; height: 260rpx; margin: 0 auto 24rpx;
  border-radius: 50%; background: #e8f7ee;
}
.ring-txt {
  position: absolute; inset: 18rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; border-radius: 50%; background: #fff;
}
.ring-txt .p { font-size: 56rpx; font-weight: 600; }
.ring-txt .q { font-size: 24rpx; color: #888; }
